# 运行环境（体积大、可重建）
.venv/
__pycache__/
*.pyc

# 本机配置：含窗口位置/主题选择，可能含 api_key —— 不进版本库
config.json

# 运行时产物
error.log
app.log
gui.log
history/

# 开发期自测截图与临时图
dev/shots/
dev/_set_clip.py
dev/_read_clip.py

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store

# 日志（含开发期日志）
*.log

# 打包产物（可随时重新生成）
*.zip

# 下载站的运行记录
site/downloads.log

# 但下载站里的安装包要进库（方便直接部署静态托管）
!site/releases/*.zip

# 隧道地址是临时的
site/public_url.txt
site/tunnel.log

# PyInstaller 产物
dist/
build/
*.spec
build_exe.log
